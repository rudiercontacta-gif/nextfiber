# =========================================================
# NextFiber — Variables de entorno
# Copia este archivo como ".env" y completa tus propias claves.
# NUNCA subas el archivo ".env" real a un repositorio público
# ni lo incluyas en un .zip que vayas a compartir.
# =========================================================

# Puerto en el que corre el servidor
PORT=3000

# En el servidor publicado pon "production". En tu computadora puedes dejarlo vacío.
NODE_ENV=production

# Clave del panel de administración (/admin/leads.html).
# Usa una clave larga y aleatoria (no una palabra ni el nombre de la empresa).
# Para generarla, ejecuta en una terminal:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# ---------------------------------------------------------
# Red y seguridad
# ---------------------------------------------------------
# TRUST_PROXY: cómo obtener la IP real del visitante (la usa el límite de envíos).
#   vacío -> confía solo en proxies de red privada (sirve para Render, Railway
#            y Nginx en el mismo servidor). Recomendado.
#   1     -> hay exactamente un proxy delante del servidor.
#   false -> el servidor recibe las conexiones directamente, sin proxy.
TRUST_PROXY=

# ALLOWED_ORIGINS: solo si el sitio (frontend) vive en OTRO dominio distinto al
# del backend. Separa varios con comas. Vacío = solo el mismo dominio (recomendado).
# Ejemplo: ALLOWED_ORIGINS=https://nextfiber.pe,https://www.nextfiber.pe
ALLOWED_ORIGINS=

# Versión de la API de Meta (WhatsApp y Messenger). Opcional.
META_GRAPH_VERSION=v19.0

# ---------------------------------------------------------
# WhatsApp (Meta Cloud API) — https://developers.facebook.com/docs/whatsapp
# 1. Crea una app de tipo "Business" en developers.facebook.com
# 2. Agrega el producto "WhatsApp" y toma el "Temporary access token" o genera uno permanente
# 3. Copia el "Phone number ID" del número de prueba o de tu número verificado
# 4. WHATSAPP_TO es el número (con código de país, sin +) que RECIBE la notificación de nuevo lead
# Nota: los mensajes de texto libre solo llegan si WHATSAPP_TO le escribió al número
# de la empresa en las últimas 24 horas. Para avisos garantizados se necesita una
# plantilla aprobada por Meta.
# ---------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=

# ---------------------------------------------------------
# Gmail (envío de correo vía Nodemailer)
# 1. Activa la verificación en 2 pasos en la cuenta de Gmail que usarás
# 2. Genera una "contraseña de aplicación" en myaccount.google.com/apppasswords
# 3. Usa esa contraseña de 16 dígitos aquí, NO la contraseña normal de la cuenta
# ---------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
SALES_EMAIL=ventas@nextfiber.pe

# ---------------------------------------------------------
# Telegram — habla con @BotFather en Telegram para crear un bot y obtener el token
# TELEGRAM_CHAT_ID: el chat/grupo que recibirá las notificaciones
# (puedes obtenerlo escribiéndole a tu bot y visitando
#  https://api.telegram.org/bot<TU_TOKEN>/getUpdates)
# ---------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------
# Facebook Messenger (webhook) — developers.facebook.com
# 1. Crea una app, agrega el producto "Messenger"
# 2. Vincula tu Página de Facebook y copia el "Page access token" en FB_PAGE_TOKEN
# 3. Copia la "Clave secreta de la app" (Configuración > Básica) en FB_APP_SECRET.
#    Sirve para comprobar que los mensajes realmente vienen de Meta.
# 4. Inventa un VERIFY_TOKEN largo y úsalo igual en el panel de Meta al verificar
#    el webhook, que debe apuntar a: https://tu-dominio.com/webhook/facebook
# Si VERIFY_TOKEN o FB_APP_SECRET están vacíos, el webhook queda desactivado.
# ---------------------------------------------------------
VERIFY_TOKEN=
FB_APP_SECRET=
FB_PAGE_TOKEN=
